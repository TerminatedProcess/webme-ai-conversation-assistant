{
  "description": "webme: reopen the project's pages on startup/resume; re-announce them on clear/compact.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/webme-session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
